{
  "compilerOptions": {
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2023",
    "resolveJsonModule": true
  },
  "compileOnSave": true,
  "include": [
    "src",
    "prisma",
    "next.config.js"
  ]
}